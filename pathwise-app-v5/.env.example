# ─────────────────────────────────────────────────────────────────────
# .env — Environment variables
# ─────────────────────────────────────────────────────────────────────
# Copy this to .env.local and update with your actual values.
# Vite exposes any VITE_ prefixed variable to the client.
# ─────────────────────────────────────────────────────────────────────

# Your backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:8000/api

# false = run the current standalone prototype without login/backend
# true  = require login and use the authentication API
VITE_AUTH_ENABLED=false

# Uses the ZIP's hook-based DashboardView. Enable only with auth and backend.
VITE_API_ENABLED=false
