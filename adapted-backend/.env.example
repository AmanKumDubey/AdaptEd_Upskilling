DB_HOST=127.0.0.1
DB_NAME=adapted
DB_USER=adaptedadmin
DB_PASSWORD=replace_with_database_password
DB_PORT=5433

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRE=7d

PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Run npm run db:migrate before starting the API. Keep model sync disabled.
DB_SYNC=false
DB_SYNC_ALTER=false

# Optional recommendation settings
AI_CHAT_ENDPOINT=https://adapted.quantana.top/api/chat
RECS_WORKER_POLL_MS=25000

# Optional scraper tuning. Set the executable path when bundled Chrome is unavailable.
PUPPETEER_EXECUTABLE_PATH=
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
SCRAPER_RESULTS_TIMEOUT_MS=45000
SCRAPER_MAX_RETRIES=3
SCRAPER_USER_AGENT=

# Optional integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
MAIL_FROM_EMAIL=
